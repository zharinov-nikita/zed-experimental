+pub(crate) fn render_dictation_page(
+    settings_window: &SettingsWindow,
+    scroll_handle: &ScrollHandle,
+    window: &mut Window,
+    cx: &mut Context<SettingsWindow>,
+) -> AnyElement {
+    let items = dictation_items();
+    let (engine_items, rest) = items.split_at(ENGINE_ITEMS);
+    let (flag_items, post_processing_items) = rest.split_at(FLAG_ITEMS);
+
+    let engine = settings_window
+        .render_sub_page_items_section(engine_items.iter().enumerate(), false, window, cx)
+        .into_any_element();
+    let flags = settings_window
+        .render_sub_page_items_section(
+            flag_items
+                .iter()
+                .enumerate()
+                .map(|(index, item)| (index + ENGINE_ITEMS, item)),
+            false,
+            window,
+            cx,
+        )
+        .into_any_element();
+    let post_processing_enabled = settings_window
+        .render_sub_page_items_section(
+            post_processing_items
+                .iter()
+                .enumerate()
+                .map(|(index, item)| (index + ENGINE_ITEMS + FLAG_ITEMS, item)),
+            false,
+            window,
+            cx,
+        )
+        .into_any_element();
+
+    let glossary = render_glossary_section(cx);
+    let model_rows = render_post_processing_model_rows(settings_window, window, cx);
+    let prompt = render_prompt_section(window, cx);
+
+    v_flex()
+        .id("dictation-settings-page")
+        .size_full()
+        .pb_16()
+        .overflow_y_scroll()
+        .track_scroll(scroll_handle)
+        .child(engine)
+        .child(glossary)
+        .child(flags)
+        .child(
+            v_flex()
+                .px_8()
+                .pt_2()
+                .child(SettingsSectionHeader::new("Post-processing").no_padding(true)),
+        )
+        .child(post_processing_enabled)
+        .child(model_rows)
+        .child(prompt)
+        .into_any_element()
+}
